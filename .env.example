# =============================================================================
# MASAR AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in the values before running the app.
# =============================================================================

# --- 1. Database Configuration ---
# For local Docker: postgresql+asyncpg://postgres:secret@localhost:5433/postgres
# For Cloud DB (Neon / Supabase): postgresql+asyncpg://user:pass@ep-xyz.neon.tech/dbname?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5433/postgres

# --- 2. Authentication & JWT ---
SECRET_KEY=your_super_secret_jwt_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRES_MINUTES=60
frontend_url=http://localhost:3000

# --- 3. Core AI & LLMs ---
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Optional Alternative LLMs
Gemini_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GROQ_API_KEY=your_groq_api_key

# --- 4. Travel & Booking APIs ---
# Nuitee API (Hotels & Rooms in UAE)
NUTIEE_API_KEY=your_nuitee_api_key

# Duffel API (Flights GDS / Sandbox)
DuffelAccesToken=duffel_test_your_duffel_token

# Google Maps / Places API (Routes & Landmarks)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Ticketmaster API (Live Concerts & Events)
TICKETMASTER_API_KEY=your_ticketmaster_key

# Web Search APIs
TAVILY_API_KEY=your_tavily_api_key
SERPER_API_KEY=your_serper_api_key

# --- 5. Email Notifications (Optional for Local Dev) ---
mail_server=smtp.gmail.com
mail_port=587
mail_username=your_email@gmail.com
mail_password=your_app_password
mail_from=noreply@masarai.com
mail_use_tls=True

# --- 6. LangSmith Observability (Optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=masar-ai


# --- Private attraction photos (AWS browser login; no keys in the frontend) ---
# Run: aws login --profile masar --region eu-north-1
AWS_PROFILE=masar
AWS_DEFAULT_REGION=eu-north-1
S3_BUCKET_NAME=your_private_photo_bucket
S3_PHOTO_URL_TTL=3600
