# Server-side configuration only. Copy to production.env on the server, chmod 600.
# Do not copy the desktop .env or AWS login cache. Do not put real secrets in Git.
MASAR_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DB?sslmode=require
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRES_MINUTES=30
CORS_ORIGINS=https://app.example.com
frontend_url=https://app.example.com
API_ALLOWED_HOSTS=api.example.com
OPENAI_API_KEY=REPLACE_WITH_SERVER_API_KEY
NUTIEE_API_KEY=sand_REPLACE_WITH_YOUR_SANDBOX_KEY
TRAVEL_PROVIDER_ENVIRONMENT=sandbox
GOOGLE_MAPS_API_KEY=
TICKETMASTER_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
mail_server=
mail_port=587
mail_username=
mail_password=
mail_from=
mail_use_tls=True
AWS_DEFAULT_REGION=eu-north-1
S3_BUCKET_NAME=masarai-pics
S3_PHOTO_URL_TTL=3600
# For EC2, attach an instance IAM role restricted to s3:GetObject on attractions/*.
# For Lightsail, arrange a supported restricted machine identity before launch.
# AWS_PROFILE must be absent. Never add root credentials or developer login files.
CHECKPOINT_BACKEND=postgres
# Optional separate PostgreSQL URL for agent checkpoints (TLS required remotely).
# CHECKPOINT_DATABASE_URL=
PASSPORT_EVIDENCE_DIR=/var/lib/masar/evidence
MAX_CONCURRENT_CHATS=2
LANGGRAPH_STRICT_MSGPACK=true
LANGSMITH_TRACING=false
# Set a separate operator secret only if authorized evidence review is needed.
PASSPORT_OPERATOR_KEY=

# Optional boxing photo checks. Enable only after migration + evidence worker setup.
PASSPORT_AUTO_BOXING=false

# Optional test-only evaluation selector; keep disabled for normal visitor use.
PASSPORT_BOXING_DEMO_ALLOWED=false

# Same evidence worker: coastal sunset, Burj Khalifa and Dubai Frame photo checks.
PASSPORT_AUTO_SCENES=false
# Optional test-mode selector for all automatic checks. If absent, legacy boxing flag applies.
PASSPORT_VISION_LIGHT_ALLOWED=false

# Private challenge evidence. Switch to s3 after IAM + privacy preflight succeed.
PASSPORT_EVIDENCE_STORAGE=local
PASSPORT_EVIDENCE_BUCKET=masarai-pics
PASSPORT_EVIDENCE_REGION=eu-north-1

# Receipt Assistant: enable after additive migration and private storage setup.
RECEIPTS_ENABLED=false
RECEIPT_STORAGE=s3
# Defaults to PASSPORT_EVIDENCE_BUCKET/REGION if omitted; requires receipts/* IAM access.
RECEIPT_BUCKET=
RECEIPT_REGION=eu-north-1
RECEIPT_OCR_ENABLED=true
RECEIPT_OCR_MODEL=gpt-4o-mini
RECEIPT_DAILY_LIMIT=20
