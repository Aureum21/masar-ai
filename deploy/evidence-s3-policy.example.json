{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckPrivateEvidenceBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::masarai-pics"
    },
    {
      "Sid": "ListEvidencePrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::masarai-pics",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "passport-evidence/*"
          ]
        }
      }
    },
    {
      "Sid": "PrivateEvidenceObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::masarai-pics/passport-evidence/*"
    }
  ]
}
